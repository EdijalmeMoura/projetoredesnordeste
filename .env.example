# Copy to .env for production and set unique secrets before deploying.
PORT=4000
DATA_DIR=./data
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_NAME=Administrador
# Strong, unique password with at least 12 characters. Never commit .env.
ADMIN_PASSWORD=
# Use at least 32 random characters. If omitted, a random secret is generated and persisted in DATA_DIR/jwt.secret.
JWT_SECRET=
